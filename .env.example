# Local development only. Deployed stages get everything from SST.
# Point these at a local or Docker Postgres, never at a deployed database.
DATABASE_URL=postgresql://vg:vg@localhost:5432/vg
SHADOW_DATABASE_URL=postgresql://vg:vg@localhost:5432/vg_shadow
# Integration tests create and drop their own databases through this one.
TEST_DATABASE_URL=postgresql://vg:vg@localhost:5432/postgres
