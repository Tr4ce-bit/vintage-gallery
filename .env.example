# ── AWS Cognito ────────────────────────────────────────────────────────────────
# User Pool and App Client IDs are public (baked into the JS bundle).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database ───────────────────────────────────────────────────────────────────
# Add ?sslmode=require for RDS. Lambda connection params (connection_limit, pool_timeout)
# are injected automatically by lib/db.ts when running on Lambda.
DATABASE_URL="postgresql://user:password@host:5432/vintage_gallery?sslmode=require"

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# ── AWS (S3 + SNS) ────────────────────────────────────────────────────────────
# On Lambda these can be omitted — the Lambda IAM role provides credentials.
# Required for local dev and for the admin upload endpoint.
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_REGION=us-east-1
S3_BUCKET=vintage-gallery-products
# Also used for Cognito JWT verification region
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# Create a 16-char App Password at: Google Account → Security → App Passwords
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Admin config ───────────────────────────────────────────────────────────────
# Comma-separated list of admin emails (fallback — prefer Cognito "admin" group).
# To use groups: aws cognito-idp admin-add-user-to-group --group-name admin ...
ADMIN_EMAILS=admin@yourdomain.com
ADMIN_PHONE=+233xxxxxxxxx

# ── App URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shop.yourdomain.com
# Admin app URL — used by the store's middleware.ts for CORS on /api/admin/*
# If unset, all cross-origin requests to /api/admin/* are blocked.
ADMIN_APP_URL=https://admin.yourdomain.com
# Used by the admin app to call the store API and by customer status emails
NEXT_PUBLIC_API_URL=https://shop.yourdomain.com

# ── External ───────────────────────────────────────────────────────────────────
# WeatherAPI.com key (weatherapi.com → dashboard). Powers auto rain-surcharge detection.
WEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# fal.ai key for AI image generation in the studio
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
