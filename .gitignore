
# clerk configuration (can include secrets)
/.clerk/

# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/admin-app/.next/

# OpenNext build output (generated by sst build/deploy)
.open-next/
/admin-app/.open-next/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma
prisma/dev.db
prisma/dev.db-journal

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# SST Ion — generated platform files and state, never commit these
.sst/

# Production env file — use GitHub Actions secrets instead
.env.production

# Local AWS config snapshots saved before risky CLI updates
.cognito-template-backup-*.json
