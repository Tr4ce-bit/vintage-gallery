// Vintage Gallery data model.
// Money is always integer pesewas (1 GHS = 100 pesewas). Never Float.
// Migrations are versioned files in prisma/migrations, applied in AWS by
// functions/migrate.ts. Never `prisma db push` against a deployed database.

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id               String   @id @default(cuid())
  cognitoSub       String   @unique
  email            String
  // Email is unique only among verified addresses, so an unverified sign-up
  // can never claim someone else's address.
  emailVerified    Boolean  @default(false)
  fullName         String
  phone            String?
  ghanaPostAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders       Order[]
  savedDesigns SavedDesign[]

  @@unique([email], where: { emailVerified: true }, map: "customers_verified_email_key")
  @@index([email])
  @@map("customers")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  collection   String   @default("")
  description  String?
  details      String[] @default([])
  pricePesewas Int
  images       String[] @default([]) // S3 object keys in the products bucket, first is primary
  badge        String?
  featured     Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants   Variant[]
  orderItems OrderItem[]

  @@index([isActive, sortOrder])
  @@map("products")
}

model Variant {
  id           String  @id @default(cuid())
  productId    String
  sku          String  @unique
  size         Size
  color        String
  // Overrides Product.pricePesewas when set.
  pricePesewas Int?
  // Units on hand and not sold. Reservations are subtracted at read time.
  // Updated only with conditional UPDATE … WHERE stock >= n (CHECK stock >= 0).
  stock        Int     @default(0)
  isActive     Boolean @default(true)

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations StockReservation[]
  orderItems   OrderItem[]

  @@unique([productId, size, color])
  @@map("variants")
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

// Units held for an unpaid order. Paying turns it into a sale (stock is
// decremented and the reservation marked CONVERTED); expiry releases it.
model StockReservation {
  id        String            @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  status    ReservationStatus @default(HELD)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([variantId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

enum ReservationStatus {
  HELD
  CONVERTED
  RELEASED
}

// ── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id               String       @id @default(cuid())
  orderNumber      String       @unique // e.g. VG4KX9M2, random and unguessable
  reference        String       @unique // our Paystack reference, created before payment starts
  status           OrderStatus  @default(PENDING_PAYMENT)
  customerId       String?
  guestEmail       String?
  subtotalPesewas  Int
  deliveryPesewas  Int
  totalPesewas     Int
  currency         String       @default("GHS")
  deliveryType     DeliveryType
  deliveryFullName String
  deliveryPhone    String
  deliveryAddress  String
  deliveryCity     String
  deliveryRegion   String
  deliveryNotes    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  paidAt           DateTime?

  customer     Customer?          @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  events       OrderEvent[]
  reservations StockReservation[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  CANCEL_REQUESTED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryType {
  STANDARD
  SAME_DAY
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String?
  variantId        String?
  studioDesignId   String?
  productName      String // captured at order time
  size             Size
  color            String
  quantity         Int
  unitPricePesewas Int
  lineTotalPesewas Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  variant Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// Audit trail: every status change, with who made it.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      String // "system", "customer:<id>", "admin:<cognito sub>", "paystack"
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("paystack")
  providerReference String        @unique
  status            PaymentStatus @default(PENDING)
  amountPesewas     Int
  currency          String        @default("GHS")
  feePesewas        Int?
  channel           String?
  rawStatus         String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  providerRefundId String?      @unique
  amountPesewas    Int
  status           RefundStatus @default(PENDING)
  requestedBy      String // admin:<cognito sub>
  createdAt        DateTime     @default(now())
  processedAt      DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

// Every Paystack webhook delivery, keyed so a repeat is spotted at once.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("paystack")
  eventKey    String    @unique // event name + reference (+ refund id)
  eventType   String
  reference   String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt])
  @@map("webhook_events")
}

// ── Admin ────────────────────────────────────────────────────────────────────

model AdminAudit {
  id         String   @id @default(cuid())
  adminSub   String
  adminEmail String
  action     String // e.g. "product.update", "order.refund"
  target     String // e.g. "product:<id>"
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminSub, createdAt])
  @@map("admin_audit")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ── Studio and newsletter ────────────────────────────────────────────────────

model StudioDesign {
  id        String   @id @default(cuid())
  name      String
  imageKey  String // S3 key in the products bucket, transparent PNG
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedDesigns SavedDesign[]

  @@map("studio_designs")
}

model SavedDesign {
  id             String   @id @default(cuid())
  customerId     String
  studioDesignId String
  shirtColor     String   @default("#FFFFFF")
  shirtSize      Size     @default(M)
  notes          String?
  createdAt      DateTime @default(now())

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  studioDesign StudioDesign @relation(fields: [studioDesignId], references: [id], onDelete: Cascade)

  @@map("saved_designs")
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String?
  // Double opt-in: only confirmed subscribers are ever mailed.
  confirmToken   String?   @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([confirmedAt])
  @@map("subscribers")
}
