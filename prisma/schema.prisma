// Vintage Gallery Store – Prisma Schema
// Database: PostgreSQL (AWS RDS)

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev on any OS.
  // "rhel-openssl-1.0.x"        = Lambda x86_64 (Amazon Linux 2)
  // "linux-arm64-openssl-3.0.x" = Lambda arm64  (Graviton — SST default)
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER PROFILE  (extends Cognito auth)
// ─────────────────────────────────────────────
model UserProfile {
  id               String   @id @default(cuid())
  cognitoId        String   @unique          // Cognito sub (user ID)
  fullName         String
  email            String   @unique
  phoneNumber      String?
  ghanaPostAddress String?                   // Ghana Post Digital Address e.g. GA-123-4567
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]
  savedDesigns     SavedDesign[]

  @@map("user_profiles")
}

// ─────────────────────────────────────────────
// PRODUCTS  (T-shirt variants)
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique @default("")
  name        String
  collection  String   @default("")
  description String?
  details     String[] @default([])
  basePrice   Float                           // price in GHS (Ghanaian Cedis)
  imageUrl    String                          // primary image, points to /public/asset/
  images      String[] @default([])           // all images
  color       String   @default("White")
  sizes       String[] @default(["XS","S","M","L","XL","XXL"])
  badge       String?                         // e.g. "New", "Limited", "Featured"
  featured    Boolean  @default(false)
  stock       Int      @default(100)          // total stock (sum of sizeStock for display)
  sizeStock   Json?                           // per-size stock e.g. {"XS":5,"S":10,"M":20}
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      Size
  color     String
  stock     Int     @default(50)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@map("product_variants")
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

// ─────────────────────────────────────────────
// DESIGNS  (overlays for the Product Customizer)
// ─────────────────────────────────────────────
model Design {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String                          // points to /public/asset/designs/
  category    String?                         // e.g. "vintage", "graphic", "text"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  savedDesigns SavedDesign[]

  @@map("designs")
}

model SavedDesign {
  id          String   @id @default(cuid())
  userId      String
  designId    String
  shirtColor  String   @default("#FFFFFF")
  shirtSize   Size     @default(M)
  notes       String?
  createdAt   DateTime @default(now())

  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  design      Design      @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("saved_designs")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────
model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique                             // e.g. "VG4KX9M2" — random, unguessable
  userId              String?                  // null for guest checkouts
  paystackReference   String      @unique      // Paystack transaction reference
  paystackAccessCode  String?                  // for re-querying status
  status              OrderStatus @default(PENDING)
  totalAmount         Float                    // in GHS
  currency            String      @default("GHS")

  // Delivery info (copied at order time so profile changes don't affect history)
  deliveryFullName    String
  deliveryPhone       String
  deliveryAddress     String                   // Street address
  deliveryCity        String   @default("")    // e.g. Accra, Kumasi
  deliveryRegion      String   @default("")    // e.g. Greater Accra
  deliveryNotes       String?

  // Guest contact email (for orders placed without an account)
  guestEmail          String?

  // Mobile Money details (non-sensitive — just network & masked number)
  momoNetwork         MomoNetwork?
  momoNumberMasked    String?                  // e.g. "024****890"

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                UserProfile? @relation(fields: [userId], references: [id])
  items               OrderItem[]

  @@index([userId])
  @@index([paystackReference])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?                          // nullable for custom-studio items
  designId    String?                          // nullable – plain shirt (no custom design)
  productName String?                          // captured at order time (denormalised)
  size        Size
  color       String
  quantity    Int
  unitPrice   Float                            // price locked at time of purchase
  subtotal    Float

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING       // awaiting payment
  PAID          // Paystack webhook confirmed
  PROCESSING    // being prepared
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum MomoNetwork {
  MTN
  TELECEL
  AIRTELTIGO
}

// ─────────────────────────────────────────────
// SETTINGS  (key-value store for admin config)
// ─────────────────────────────────────────────
model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────
// SUBSCRIBERS  (newsletter / mailing list)
// ─────────────────────────────────────────────
model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String?                  // e.g. "newsletter", "checkout", "footer"
  unsubscribed Boolean  @default(false) // soft-delete: keep history but exclude from sends
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([unsubscribed])
  @@map("subscribers")
}

// ─────────────────────────────────────────────
// STUDIO DESIGNS  (uploadable graphics for the custom studio)
// ─────────────────────────────────────────────
model StudioDesign {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String                          // S3 URL — must be transparent PNG
  category  String?                         // optional grouping label
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_designs")
}
